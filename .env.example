# Copy to .env. Uncomment and fill only the provider key you use.
# Never commit .env or a real key. Environment variables are also supported.

# Gemini: dashboard and CLI default (gemini-2.5-flash)
# AI_API_KEY=your-gemini-api-key

# OpenAI: CLI only, with --model gpt-5.4
# OPENAI_API_KEY=your-openai-api-key

# These keys are not interchangeable. Other providers need an adapter.
